      %10 = nvws.semaphore.acquire %2 {ttg.partition = array<i32: 0>} : <[!ttg.memdesc<1x1xi32, #shared, #smem, mutable>]> -> !ttg.async.token
      "use"(%9) {ttg.partition = array<i32: 1>} : (tensor<1xi32, #blocked>) -> ()
